/* ═══════════════════════════════════════════════
   Activity Detail — 活动详情（参与者视角）
   ═══════════════════════════════════════════════ */

page {
  background-color: #F5F7FA;
  background-image: linear-gradient(180deg, #E7ECFB 0%, #EFF3FB 300rpx, #F5F7FA 640rpx);
  background-repeat: no-repeat;
}

.container { padding: 32rpx 32rpx 0; }

/* ═══════════════ Hero 头卡：450% 流动渐变 + 柔光 ═══════════════ */
.hero-card {
  position: relative;
  overflow: hidden;
  background-color: #667EEA;
  background-image: linear-gradient(135deg, #667EEA 0%, #764BA2 25%, #5B86E5 50%, #8E5BD1 75%, #667EEA 100%);
  background-size: 400% 400%;
  animation: gradientFlow 14s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  border-radius: 40rpx;
  padding: 40rpx 32rpx 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 24rpx 56rpx rgba(102, 126, 234, 0.32),
              0 4rpx 12rpx rgba(118, 75, 162, 0.16);
}
/* 右上角柔光：让渐变有体积感、不刺眼 */
.hero-card::after {
  content: '';
  position: absolute;
  top: -40%;
  right: -20%;
  width: 460rpx;
  height: 460rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0) 70%);
  pointer-events: none;
}

/* 玻璃图标块 + 缓慢漂浮 */
.hero-icon {
  position: relative;
  z-index: 1;
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background-color: rgba(255, 255, 255, 0.16);
  background-image: linear-gradient(135deg, rgba(255, 255, 255, 0.26) 0%, rgba(255, 255, 255, 0.06) 100%);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  box-shadow: 0 10rpx 24rpx rgba(15, 10, 40, 0.16);
  animation: floatSoft 4s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}
.hero-emoji { font-size: 44rpx; }

.hero-name {
  position: relative;
  z-index: 1;
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
  text-align: center;
  margin-bottom: 14rpx;
  letter-spacing: 1rpx;
  text-shadow: 0 4rpx 16rpx rgba(15, 10, 40, 0.16);
}

.hero-tags { position: relative; z-index: 1; display: flex; gap: 12rpx; margin-bottom: 24rpx; flex-wrap: wrap; justify-content: center; }
.hero-tag {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 999rpx;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}
/* 进行中：呼吸脉冲 */
.ht-active {
  background: rgba(52, 199, 89, 0.22);
  border-color: rgba(52, 199, 89, 0.3);
  color: #EAFBF0;
  animation: badgeBreath 2.8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}
.ht-closed { background: rgba(255, 255, 255, 0.08); border-color: rgba(255, 255, 255, 0.1); color: rgba(255, 255, 255, 0.55); }

.hero-meta {
  position: relative;
  z-index: 1;
  width: 100%;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.14);
}
.hm-row { display: flex; justify-content: space-between; align-items: center; padding: 9rpx 0; }
.hm-l { font-size: 26rpx; color: rgba(255, 255, 255, 0.62); }
.hm-v { font-size: 26rpx; color: rgba(255, 255, 255, 0.95); font-weight: 600; }
.hm-code {
  font-family: monospace;
  font-size: 28rpx;
  font-weight: 700;
  color: #FFE8A3;
  letter-spacing: 4rpx;
  text-shadow: 0 0 20rpx rgba(255, 232, 163, 0.35);
}

/* ═══════════════ 快捷操作（3D touch 质感） ═══════════════ */
.quick-row { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 26rpx 0;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(26, 26, 46, 0.07), inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  transition: transform 300ms cubic-bezier(0.34, 1.56, 0.64, 1),
              box-shadow 300ms cubic-bezier(0.4, 0, 0.2, 1);
  animation: fadeInUp 420ms cubic-bezier(0.25, 0.8, 0.25, 1) backwards;
}
.quick-item:nth-child(2) { animation-delay: 70ms; }
.quick-item:nth-child(3) { animation-delay: 140ms; }
.quick-item:active {
  transform: scale(0.94) translateY(2rpx);
  box-shadow: 0 4rpx 14rpx rgba(26, 26, 46, 0.08);
}
.qi-dim { opacity: 0.45; filter: grayscale(0.35); }
.qi-emoji { font-size: 40rpx; line-height: 1; }
.qi-label { font-size: 26rpx; font-weight: 600; color: var(--text-2); }

/* ═══════════════ 区块标题（小渐变条 + 文字） ═══════════════ */
.sec-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: var(--text-1);
  font-weight: 700;
  letter-spacing: 0;
  margin-bottom: 22rpx;
}
.sec-label::before {
  content: '';
  width: 8rpx;
  height: 28rpx;
  border-radius: 999rpx;
  background-image: linear-gradient(180deg, #667EEA 0%, #764BA2 100%);
  flex-shrink: 0;
}

/* ═══════════════ 今日状态标签（呼吸 + 光点脉冲） ═══════════════ */
.status-row { display: flex; justify-content: center; margin-bottom: 24rpx; }
.sp {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  animation: badgeBreath 2.8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}
.sp-dot { width: 12rpx; height: 12rpx; border-radius: 50%; animation: dotHalo 2.8s cubic-bezier(0.4, 0, 0.2, 1) infinite; }
.sd-ok { background: #34C759; color: #34C759; }
.sd-late { background: #FF9500; color: #FF9500; }
.sd-bad { background: #FF3B30; color: #FF3B30; }
.sd-gray { background: #8E8E93; color: #8E8E93; }
.sd-blue { background: #5B86E5; color: #5B86E5; }
.sd-purple { background: #AF52DE; color: #AF52DE; }

.sp-ok { background: rgba(52, 199, 89, 0.10); color: #2AA94B; }
.sp-late { background: rgba(255, 149, 0, 0.10); color: #E08200; }
.sp-bad { background: rgba(255, 59, 48, 0.10); color: #E02A20; }
.sp-gray { background: rgba(142, 142, 147, 0.12); color: #77777C; }
.sp-wait { background: rgba(91, 134, 229, 0.10); color: #4A75D6; }
.sp-ready { background: rgba(102, 126, 234, 0.10); color: #667EEA; }

/* ═══════════════ 主行动按钮：流动渐变 + 扫光 ═══════════════ */
.big-btn {
  position: relative;
  overflow: hidden;
  width: 100%;
  height: 104rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 32rpx;
  font-weight: 700;
  transition: transform 300ms cubic-bezier(0.34, 1.56, 0.64, 1),
              box-shadow 300ms cubic-bezier(0.4, 0, 0.2, 1);
}
.bb-ok {
  background-color: #667EEA;
  background-image: linear-gradient(135deg, #667EEA 0%, #764BA2 25%, #5B86E5 50%, #8E5BD1 75%, #667EEA 100%);
  background-size: 400% 400%;
  animation: gradientFlow 8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  color: #fff;
  box-shadow: 0 12rpx 32rpx rgba(102, 126, 234, 0.30);
}
.bb-ok::after {
  content: '';
  position: absolute;
  top: 0; left: -120%;
  width: 60%; height: 100%;
  background: linear-gradient(100deg, transparent 0%, rgba(255, 255, 255, 0.36) 50%, transparent 100%);
  transform: skewX(-18deg);
  animation: shineSweep 3.6s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  pointer-events: none;
}
.bb-ok:active { transform: scale(0.96); box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.26); }
.bb-dis { background: #F1F2F7; color: #B4B6C4; }

/* ═══════════════ 我的统计 ═══════════════ */
.stat-row { display: flex; justify-content: space-around; }
.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  flex: 1;
  animation: fadeInUp 420ms cubic-bezier(0.25, 0.8, 0.25, 1) backwards;
}
.stat-item:nth-child(2) { animation-delay: 60ms; }
.stat-item:nth-child(3) { animation-delay: 120ms; }
.stat-item:nth-child(4) { animation-delay: 180ms; }
.si-num { font-size: 44rpx; font-weight: 800; color: var(--text-1); line-height: 1.1; letter-spacing: -1rpx; }
.si-label { font-size: 24rpx; color: var(--text-3); }
.c-green { color: #34C759; }
.c-orange { color: #FF9500; }
.c-red { color: #FF3B30; }
.c-gray { color: #8E8E93; }

/* ═══════════════ 菜单卡：按压反馈 + 箭头位移 ═══════════════ */
.menu-card { padding: 8rpx 24rpx; }
.menu-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 0;
  font-size: 30rpx;
  color: var(--text-1);
  transition: background 300ms cubic-bezier(0.4, 0, 0.2, 1);
}
.menu-row:active { background: #F7F8FC; }
.m-arrow {
  font-size: 36rpx;
  color: #C7C9D9;
  transition: transform 300ms cubic-bezier(0.34, 1.56, 0.64, 1), color 300ms cubic-bezier(0.4, 0, 0.2, 1);
}
.menu-row:active .m-arrow { transform: translateX(8rpx); color: #667EEA; }
.menu-sep { height: 1rpx; background: #F2F3F8; }
