<view class="container">
  <nav-back />
  <view wx:if="{{list.length === 0}}" class="empty-state"><text class="empty-emoji">✅</text><text class="empty-title">暂无待审批请假</text></view>
  <view wx:for="{{list}}" wx:key="id" class="card lc">
    <view class="lh"><view class="ainfo"><view class="aa"><text class="aai">{{item.userName ? item.userName.charAt(0) : '?'}}</text></view><view class="ad"><text class="an">{{item.userName || '申请人' + item.userId}}</text><text class="aid">ID: {{item.userId}}</text></view></view><view class="lb">待审批</view></view>
    <view class="ldiv"></view>
    <view class="ld"><view class="ldr"><text class="ldl">请假日期</text><text class="ldv">{{item.startDate}} — {{item.endDate}}</text></view>
    <view wx:if="{{item.destination}}" class="ldr"><text class="ldl">去向</text><text class="ldv">{{item.destination}}</text></view>
    <view wx:if="{{item.reason}}" class="ldr"><text class="ldl">原因</text><text class="ldv">{{item.reason}}</text></view>
    <view class="ldr"><text class="ldl">紧急联系人</text><text class="ldv">{{item.emergencyContact}}</text></view></view>
    <view class="lact"><view class="lbtn lbtn-no" data-id="{{item.id}}" bindtap="reject"><text>拒绝</text></view><view class="lbtn lbtn-ok" data-id="{{item.id}}" bindtap="approve"><text>通过</text></view></view>
  </view>
  <view class="safe-bottom"></view>
</view>
