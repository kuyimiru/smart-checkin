<view class="container" style="padding-top:16rpx;">
  <view style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20rpx;">
    <view><text style="font-size:24rpx;color:#999;display:block;">你好 👋</text><text style="font-size:38rpx;font-weight:800;color:#333;">智能打卡</text></view>
    <view style="padding:10rpx 24rpx;border-radius:24rpx;background:linear-gradient(135deg,#667EEA,#764BA2);" bindtap="openJoinDialog"><text style="font-size:24rpx;color:#fff;font-weight:600;">加入活动</text></view>
  </view>

  <view style="display:flex;background:#fff;border-radius:24rpx;padding:6rpx;margin-bottom:20rpx;box-shadow:0 2rpx 8rpx rgba(0,0,0,0.03);position:relative;">
    <view style="position:absolute;top:6rpx;left:6rpx;height:calc(100% - 12rpx);width:calc(33.33% - 4rpx);background:linear-gradient(135deg,#667EEA,#764BA2);border-radius:20rpx;transition:transform 0.35s cubic-bezier(0.34,1.56,0.64,1);transform:translateX({{segOffset}}%);z-index:0;"></view>
    <view wx:for="{{tabs}}" wx:key="key" style="flex:1;text-align:center;padding:16rpx 0;position:relative;z-index:1;" data-tab="{{item.key}}" data-index="{{index}}" bindtap="switchTab">
      <text style="font-size:26rpx;{{activeTab === item.key ? 'color:#fff;font-weight:700;' : 'color:#999;'}}">{{item.label}}<text wx:if="{{item.count > 0}}" style="margin-left:4rpx;"> {{item.count}}</text></text>
    </view>
  </view>

  <view wx:if="{{activeTab === 'joined'}}">
    <view wx:if="{{joined.length === 0}}" class="empty-state"><text class="empty-emoji">📋</text><text class="empty-title">还没有参与任何活动</text><text class="empty-desc">创建新活动或输入邀请码加入</text></view>
    <view wx:for="{{joined}}" wx:key="id" class="card" style="padding:0;overflow:hidden;display:flex;" bindtap="goDetail" data-id="{{item.id}}" data-role="joined">
      <view style="width:7rpx;background:linear-gradient(180deg,#5B86E5,#36D1DC);flex-shrink:0;"></view>
      <view style="flex:1;padding:20rpx;">
        <view style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:10rpx;">
          <view style="flex:1;"><text style="font-size:28rpx;font-weight:700;color:#333;display:block;">{{item.name}}</text><text style="font-size:22rpx;color:#999;">{{item.startDate}} — {{item.endDate}}</text></view>
          <view style="display:flex;align-items:center;gap:4rpx;padding:4rpx 14rpx;border-radius:16rpx;font-size:20rpx;font-weight:600;{{item.displayStatus === 'active' ? 'background:rgba(52,199,89,0.08);color:#34C759;' : item.displayStatus === 'pending' ? 'background:rgba(102,126,234,0.08);color:#667EEA;' : 'background:#f5f5f5;color:#999;'}}"><view style="width:8rpx;height:8rpx;border-radius:50%;background:{{item.displayStatus === 'active' ? '#34C759' : item.displayStatus === 'pending' ? '#667EEA' : '#999'}};"></view>{{item.displayStatus === 'active' ? '进行中' : item.displayStatus === 'pending' ? '未开始' : item.displayStatus === 'closed' ? '已关闭' : '已结束'}}</view>
        </view>
        <view style="display:flex;gap:8rpx;">
          <text style="font-size:20rpx;color:#999;background:#F5F6FA;padding:4rpx 12rpx;border-radius:10rpx;">🕐 {{item.checkInStartTime}}-{{item.checkInEndTime}}</text>
          <text style="font-size:20rpx;color:#999;background:#F5F6FA;padding:4rpx 12rpx;border-radius:10rpx;">{{item.checkInType === 'location' ? '📍 定位' : item.checkInType === 'face' ? '📷 人脸' : '📍📷 组合'}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{activeTab === 'created'}}">
    <view wx:if="{{created.length === 0}}" class="empty-state"><text class="empty-emoji">✨</text><text class="empty-title">还没有创建活动</text></view>
    <view wx:for="{{created}}" wx:key="id" class="card" style="padding:0;overflow:hidden;display:flex;" bindtap="goDetail" data-id="{{item.id}}" data-role="managing">
      <view style="width:7rpx;background:linear-gradient(180deg,#667EEA,#764BA2);flex-shrink:0;"></view>
      <view style="flex:1;padding:20rpx;">
        <view style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:10rpx;">
          <view style="flex:1;"><text style="font-size:28rpx;font-weight:700;color:#333;display:block;">{{item.name}}</text><text style="font-size:22rpx;color:#999;">{{item.startDate}} — {{item.endDate}}</text></view>
          <view style="display:flex;align-items:center;gap:4rpx;padding:4rpx 14rpx;border-radius:16rpx;font-size:20rpx;font-weight:600;{{item.displayStatus === 'active' ? 'background:rgba(52,199,89,0.08);color:#34C759;' : item.displayStatus === 'pending' ? 'background:rgba(102,126,234,0.08);color:#667EEA;' : 'background:#f5f5f5;color:#999;'}}"><view style="width:8rpx;height:8rpx;border-radius:50%;background:{{item.displayStatus === 'active' ? '#34C759' : item.displayStatus === 'pending' ? '#667EEA' : '#999'}};"></view>{{item.displayStatus === 'active' ? '进行中' : item.displayStatus === 'pending' ? '未开始' : item.displayStatus === 'closed' ? '已关闭' : '已结束'}}</view>
        </view>
        <view style="display:flex;align-items:center;gap:8rpx;padding:8rpx 14rpx;background:rgba(102,126,234,0.04);border-radius:10rpx;"><text style="font-size:20rpx;color:#999;">邀请码</text><text style="font-size:22rpx;font-weight:700;color:#667EEA;letter-spacing:3rpx;font-family:monospace;">{{item.inviteCode}}</text></view>
      </view>
    </view>
  </view>

  <view wx:if="{{activeTab === 'managing'}}">
    <view wx:if="{{managing.length === 0}}" class="empty-state"><text class="empty-emoji">🛡️</text><text class="empty-title">没有负责的活动</text></view>
    <view wx:for="{{managing}}" wx:key="id" class="card" style="padding:0;overflow:hidden;display:flex;" bindtap="goDetail" data-id="{{item.id}}" data-role="managing">
      <view style="width:7rpx;background:linear-gradient(180deg,#34C759,#30D158);flex-shrink:0;"></view>
      <view style="flex:1;padding:20rpx;">
        <view style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:10rpx;">
          <view style="flex:1;"><text style="font-size:28rpx;font-weight:700;color:#333;display:block;">{{item.name}}</text><text style="font-size:22rpx;color:#999;">{{item.startDate}} — {{item.endDate}}</text></view>
          <view style="display:flex;align-items:center;gap:4rpx;padding:4rpx 14rpx;border-radius:16rpx;font-size:20rpx;font-weight:600;{{item.displayStatus === 'active' ? 'background:rgba(52,199,89,0.08);color:#34C759;' : item.displayStatus === 'pending' ? 'background:rgba(102,126,234,0.08);color:#667EEA;' : 'background:#f5f5f5;color:#999;'}}"><view style="width:8rpx;height:8rpx;border-radius:50%;background:{{item.displayStatus === 'active' ? '#34C759' : item.displayStatus === 'pending' ? '#667EEA' : '#999'}};"></view>{{item.displayStatus === 'active' ? '进行中' : item.displayStatus === 'pending' ? '未开始' : item.displayStatus === 'closed' ? '已关闭' : '已结束'}}</view>
        </view>
        <view style="display:flex;align-items:center;gap:8rpx;padding:8rpx 14rpx;background:rgba(102,126,234,0.04);border-radius:10rpx;"><text style="font-size:20rpx;color:#999;">邀请码</text><text style="font-size:22rpx;font-weight:700;color:#667EEA;letter-spacing:3rpx;font-family:monospace;">{{item.inviteCode}}</text></view>
      </view>
    </view>
  </view>

  <view style="position:fixed;right:32rpx;bottom:120rpx;width:104rpx;height:104rpx;border-radius:50%;background:linear-gradient(135deg,#667EEA,#764BA2);display:flex;align-items:center;justify-content:center;box-shadow:0 6rpx 28rpx rgba(102,126,234,0.3);z-index:99;" bindtap="goCreate">
    <text style="font-size:44rpx;color:#fff;font-weight:300;">+</text>
  </view>

  <view wx:if="{{showJoinDialog}}" class="dialog-overlay" catchtap="closeJoinDialog">
    <view class="dialog-card" catchtap="noop">
      <text class="dialog-title">加入活动</text>
      <input style="width:100%;height:90rpx;background:#F5F6FA;border-radius:16rpx;text-align:center;font-size:36rpx;font-weight:700;letter-spacing:10rpx;margin:20rpx 0;font-family:monospace;" placeholder="输入6位邀请码" maxlength="6" value="{{inviteCode}}" bindinput="onInviteCodeInput" focus="{{showJoinDialog}}" />
      <view class="dialog-actions"><view class="dialog-btn dialog-btn-cancel" bindtap="closeJoinDialog">取消</view><view class="dialog-btn dialog-btn-confirm" bindtap="doJoin">确认加入</view></view>
    </view>
  </view>
  <view class="safe-bottom"></view>
</view>
