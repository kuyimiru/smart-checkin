/* ═══════════════════════════════════════════════
   Activity Admin — 活动管理（管理端）
   ═══════════════════════════════════════════════ */

page {
  background-color: #F5F7FA;
  background-image: linear-gradient(180deg, #E7ECFB 0%, #EFF3FB 280rpx, #F5F7FA 600rpx);
  background-repeat: no-repeat;
}

.container { padding: 32rpx 32rpx 0; }

/* ═══ 区块标题：渐变小竖条 ═══ */
.sec-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: var(--text-1);
  font-weight: 700;
  letter-spacing: 0;
  margin-bottom: 22rpx;
}
.sec-label::before {
  content: '';
  width: 8rpx;
  height: 28rpx;
  border-radius: 999rpx;
  background-image: linear-gradient(180deg, #667EEA 0%, #764BA2 100%);
  flex-shrink: 0;
}

/* ═══════════════ 数据概览：指标卡片网格（入场 + 数字弹出） ═══════════════ */
.dg { display: flex; flex-wrap: wrap; gap: 16rpx; }
.di {
  width: calc(33.33% - 11rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 24rpx 8rpx;
  border-radius: 24rpx;
  background-color: #F8F9FD;
  background-image: linear-gradient(160deg, rgba(102, 126, 234, 0.07) 0%, rgba(118, 75, 162, 0.03) 100%);
  box-shadow: inset 0 0 0 1rpx rgba(102, 126, 234, 0.06);
  transition: transform 300ms cubic-bezier(0.34, 1.56, 0.64, 1),
              box-shadow 300ms cubic-bezier(0.4, 0, 0.2, 1);
  animation: fadeInUp 380ms cubic-bezier(0.25, 0.8, 0.25, 1) backwards;
}
.di:nth-child(2) { animation-delay: 50ms; }
.di:nth-child(3) { animation-delay: 100ms; }
.di:nth-child(4) { animation-delay: 150ms; }
.di:nth-child(5) { animation-delay: 200ms; }
.di:nth-child(6) { animation-delay: 250ms; }
.di:active { transform: scale(0.96); box-shadow: inset 0 0 0 1rpx rgba(102, 126, 234, 0.16); }
.di-emoji { font-size: 30rpx; line-height: 1; margin-bottom: 6rpx; }
/* 数字弹出，模拟计数器到位 */
.di-num {
  font-size: 42rpx;
  font-weight: 800;
  color: var(--text-1);
  line-height: 1.1;
  letter-spacing: -1rpx;
  animation: scaleUp 460ms cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
}
.di-lab { font-size: 24rpx; color: var(--text-3); margin-top: 2rpx; }
.c-g { color: #34C759; }
.c-o { color: #FF9500; }
.c-r { color: #FF3B30; }
.c-gray { color: #8E8E93; }
.c-b { color: #5B86E5; }

/* ═══════════════ 活动管理入口：白卡悬浮 + 图标渐变片 ═══════════════ */
.ag { display: flex; flex-wrap: wrap; gap: 16rpx; }
.ai {
  width: calc(33.33% - 11rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 24rpx 8rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(26, 26, 46, 0.06);
  transition: transform 300ms cubic-bezier(0.34, 1.56, 0.64, 1),
              box-shadow 300ms cubic-bezier(0.4, 0, 0.2, 1);
  animation: fadeInUp 420ms cubic-bezier(0.25, 0.8, 0.25, 1) backwards;
}
.ai:nth-child(2) { animation-delay: 60ms; }
.ai:nth-child(3) { animation-delay: 120ms; }
.ai:nth-child(4) { animation-delay: 180ms; }
.ai:nth-child(5) { animation-delay: 240ms; }
.ai:nth-child(6) { animation-delay: 300ms; }
.ai:active { transform: scale(0.94); box-shadow: 0 4rpx 14rpx rgba(26, 26, 46, 0.08); }
.ai-emoji {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background-image: linear-gradient(135deg, rgba(102, 126, 234, 0.14) 0%, rgba(118, 75, 162, 0.10) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 1;
}
.ai-txt { font-size: 24rpx; color: var(--text-2); font-weight: 600; text-align: center; }

/* ═══════════════ 参与者名单 ═══════════════ */
.mc { font-size: 26rpx; color: var(--text-3); font-weight: 600; }

.mr {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F4F5FA;
  animation: fadeInUp 320ms cubic-bezier(0.25, 0.8, 0.25, 1) backwards;
  transition: background 300ms cubic-bezier(0.4, 0, 0.2, 1);
}
.mr:last-child { border-bottom: none; }

/* 圆形渐变头像 */
.ma {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 8rpx 20rpx rgba(102, 126, 234, 0.26);
}
.mai { font-size: 28rpx; font-weight: 700; color: #fff; }
.ma-in { background-image: linear-gradient(135deg, #667EEA 0%, #764BA2 100%); }
.ma-out { background-image: linear-gradient(135deg, #AF52DE 0%, #F5576C 100%); }

.mi { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.mt { display: flex; align-items: center; gap: 10rpx; }
.mn {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 异常用户标签：紫色 + 呼吸 */
.mat {
  font-size: 20rpx;
  font-weight: 700;
  color: #AF52DE;
  background: rgba(175, 82, 222, 0.10);
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
  animation: badgeBreath 2.8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}

/* 今日状态：淡色胶囊 */
.ms {
  font-size: 24rpx;
  font-weight: 600;
  align-self: flex-start;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(142, 142, 147, 0.10);
  color: var(--text-3);
}
.ms.normal { background: rgba(52, 199, 89, 0.10); color: #2AA94B; }
.ms.late { background: rgba(255, 149, 0, 0.10); color: #E08200; }
.ms.abnormal { background: rgba(255, 59, 48, 0.10); color: #E02A20; }
.ms.leave { background: rgba(142, 142, 147, 0.12); color: #77777C; }

/* 状态指示灯：脉冲光晕 */
.mid {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
  animation: dotHalo 2.8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}
.mid-ok { background: #34C759; color: #34C759; }
.mid-late { background: #FF9500; color: #FF9500; }
.mid-bad { background: #FF3B30; color: #FF3B30; }
.mid-gray { background: #8E8E93; color: #8E8E93; }
.mid-none { background: #D8DAE5; color: #D8DAE5; }

/* ═══════════════ 活动信息 ═══════════════ */
.ir {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F4F5FA;
}
.ir:last-child { border-bottom: none; }
.il { font-size: 28rpx; color: var(--text-3); }
.iv { font-size: 28rpx; color: var(--text-1); font-weight: 600; }
.ic {
  font-family: monospace;
  font-size: 30rpx;
  font-weight: 700;
  color: #667EEA;
  letter-spacing: 4rpx;
}
