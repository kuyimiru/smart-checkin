/* ═══════════════════════════════════════════════
   Check-in — Map · Face · Pure CSS + Confetti
   ═══════════════════════════════════════════════ */

.page-wrapper {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
}

/* 流动主渐变背景（background-size:400% + gradientFlow 缓慢流动） */
.bg-gradient {
  position: fixed;
  inset: 0;
  background-color: #4F46E5;
  background-image: linear-gradient(150deg,
    #4F46E5 0%,
    #5B3FB0 28%,
    #667EEA 50%,
    #764BA2 72%,
    #4B3A90 100%);
  background-size: 400% 400%;
  animation: gradientFlow 22s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  z-index: -2;
}
/* 柔光层：让流动渐变有体积感 */
.bg-gradient::before {
  content: '';
  position: absolute; inset: 0;
  background:
    radial-gradient(ellipse 100% 70% at 30% 0%, rgba(102, 126, 234, 0.45) 0%, transparent 55%),
    radial-gradient(ellipse 80% 80% at 70% 40%, rgba(168, 85, 247, 0.32) 0%, transparent 50%),
    radial-gradient(ellipse 70% 60% at 50% 100%, rgba(15, 11, 46, 0.35) 0%, transparent 55%);
}
.bg-gradient::after {
  content: '';
  position: absolute; inset: 0;
  background:
    radial-gradient(ellipse at 20% 50%, rgba(255,255,255,0.05) 0%, transparent 60%),
    radial-gradient(ellipse at 80% 20%, rgba(255,255,255,0.04) 0%, transparent 50%);
}

@keyframes gradientFlow {
  0%   { background-position: 0% 50%; }
  50%  { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

.page-scroll { padding: 0 32rpx; }

/* ═══ Activity card ═══ */
.activity-card { margin-top: 20rpx; margin-bottom: 24rpx; }

/* ═══ 玻璃拟态卡片（半透明 + blur，保留降级底色） ═══ */
.glass-card {
  background-color: rgba(42, 30, 92, 0.28);
  background-image: linear-gradient(135deg, rgba(255, 255, 255, 0.16) 0%, rgba(255, 255, 255, 0.06) 100%);
  backdrop-filter: blur(20px) saturate(160%);
  -webkit-backdrop-filter: blur(20px) saturate(160%);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 40rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 16rpx 40rpx rgba(15, 10, 40, 0.22), inset 0 1rpx 0 rgba(255, 255, 255, 0.14);
  animation: fadeInUp 420ms cubic-bezier(0.25, 0.8, 0.25, 1) backwards;
}

/* 导航右侧占位（wxml 使用 nav-placeholder），保证标题真正居中 */
.nav-placeholder { width: 64rpx; height: 64rpx; }

/* 离屏水印画布：仅确保不参与布局（不改动其像素内容） */
.wm-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  pointer-events: none;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(28rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
.activity-icon-row { display: flex; align-items: center; gap: 20rpx; }
.act-icon-box {
  width: 80rpx; height: 80rpx;
  border-radius: 20rpx;
  background: rgba(255,255,255,0.15);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  border: 1rpx solid rgba(255,255,255,0.12);
}
.act-icon-emoji { font-size: 40rpx; }
.act-info { display: flex; flex-direction: column; gap: 6rpx; flex: 1; min-width: 0; }
.act-name {
  font-size: 32rpx; font-weight: 700; color: #fff;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.act-type { font-size: 24rpx; color: rgba(255,255,255,0.55); }

/* ═══ Map ═══ */
.map-card {
  border-radius: 32rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  box-shadow: 0 20rpx 52rpx rgba(15, 10, 40, 0.26);
  position: relative;
  animation: fadeInUp 420ms cubic-bezier(0.25, 0.8, 0.25, 1) backwards;
}
.checkin-map { width: 100%; height: 50vh; display: block; }

/* Map overlay (idle / locating / error states) */
.map-overlay { position: absolute; inset: 0; }

.map-skeleton {
  width: 100%; height: 100%;
  background: linear-gradient(135deg, #e8ecf8 0%, #dde2f5 40%, #e4e0f8 70%, #e8ecf8 100%);
  background-size: 300% 300%;
  animation: mapShimmer 2s ease-in-out infinite;
}
@keyframes mapShimmer {
  0%   { background-position: 0% 0%; }
  50%  { background-position: 100% 100%; }
  100% { background-position: 0% 0%; }
}

.locating-center {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  width: 80%;
}

/* ── Locating spinner ── */
.spinner-ring {
  width: 60rpx; height: 60rpx;
  border: 4rpx solid rgba(102,126,234,0.15);
  border-top-color: #667EEA;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

.locating-text {
  font-size: 28rpx; color: #667EEA; font-weight: 600;
}
.locating-hint {
  font-size: 22rpx; color: #999; text-align: center;
}

/* ── Idle: trigger button ── */
.locate-trigger {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 48rpx 40rpx;
  background: rgba(255,255,255,0.85);
  backdrop-filter: blur(12px);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.08);
  transition: all 0.25s ease;
}
.locate-trigger:active {
  transform: scale(0.95);
  background: rgba(255,255,255,0.95);
}
.locate-trigger-icon {
  font-size: 56rpx;
}
.locate-trigger-text {
  font-size: 30rpx; font-weight: 700; color: #667EEA;
}
.locate-trigger-hint {
  font-size: 22rpx; color: #999; text-align: center;
}

/* ── Error box ── */
.locate-error-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 36rpx 32rpx;
  background: rgba(255,255,255,0.85);
  backdrop-filter: blur(12px);
  border-radius: 28rpx;
  border: 1rpx solid rgba(255,100,100,0.25);
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.08);
}
.error-emoji { font-size: 48rpx; }
.error-msg {
  font-size: 26rpx; color: #4A4A6A; text-align: center; line-height: 1.6;
}
.error-btns { display: flex; gap: 16rpx; margin-top: 8rpx; }
.err-btn {
  padding: 14rpx 32rpx; border-radius: 32rpx;
  font-size: 24rpx; font-weight: 600;
  transition: all 0.2s ease;
}
.err-btn:active { transform: scale(0.94); }
.err-btn-retry {
  background: linear-gradient(135deg, #667EEA, #764BA2);
  color: #fff;
}
.err-btn-setting {
  background: #fff; color: #667EEA;
  border: 1rpx solid rgba(102,126,234,0.3);
}

/* ── Refresh location button ── */
.refresh-loc-btn {
  margin-top: 20rpx;
  padding: 12rpx 32rpx;
  border-radius: 24rpx;
  background: rgba(255,255,255,0.1);
  border: 1rpx solid rgba(255,255,255,0.15);
  font-size: 24rpx; color: rgba(255,255,255,0.65);
  text-align: center;
  transition: all 0.25s ease;
}
.refresh-loc-btn:active {
  background: rgba(255,255,255,0.2);
  transform: scale(0.95);
}

/* ═══ Distance Section：玻璃面板承载距离信息 ═══ */
.distance-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 36rpx 28rpx;
  margin-bottom: 24rpx;
  background-color: rgba(42, 30, 92, 0.26);
  background-image: linear-gradient(160deg, rgba(255, 255, 255, 0.15) 0%, rgba(255, 255, 255, 0.04) 100%);
  backdrop-filter: blur(20px) saturate(150%);
  -webkit-backdrop-filter: blur(20px) saturate(150%);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 40rpx;
  box-shadow: 0 16rpx 40rpx rgba(15, 10, 40, 0.20), inset 0 1rpx 0 rgba(255, 255, 255, 0.12);
  animation: fadeInUp 420ms cubic-bezier(0.25, 0.8, 0.25, 1) backwards;
}

/* Range indicator */
.range-indicator {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 32rpx;
  border-radius: 40rpx;
  margin-bottom: 24rpx;
  backdrop-filter: blur(12px);
}

.range-ok {
  background: rgba(52,199,89,0.15);
  border: 1rpx solid rgba(52,199,89,0.25);
}
.range-out {
  background: rgba(255,59,48,0.12);
  border: 1rpx solid rgba(255,59,48,0.2);
}

.range-dot { width: 16rpx; height: 16rpx; border-radius: 50%; }
.green-dot {
  background: #52C41A;
  box-shadow: 0 0 16rpx rgba(82,196,26,0.5);
  animation: dotPulse 1.5s ease-in-out infinite;
}
.red-dot {
  background: #F5222D;
  box-shadow: 0 0 16rpx rgba(245,34,45,0.5);
  animation: dotPulse 1.5s ease-in-out infinite;
}
@keyframes dotPulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50%      { transform: scale(1.5); opacity: 0.5; }
}

.range-label { font-size: 28rpx; font-weight: 600; color: #fff; }
.range-emoji { font-size: 28rpx; }
.out-range-tip {
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
  margin-bottom: 16rpx;
  text-align: center;
}

/* Distance number */
.distance-display {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.dist-number {
  font-size: 64rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 2rpx;
  text-shadow: 0 4rpx 16rpx rgba(0,0,0,0.12);
  transition: all 0.3s ease;
}
.dist-bounce .dist-number {
  animation: numBounce 0.6s cubic-bezier(0.68, -0.55, 0.27, 1.55);
}
@keyframes numBounce {
  0%   { transform: scale(1); }
  30%  { transform: scale(1.15); }
  60%  { transform: scale(0.95); }
  100% { transform: scale(1); }
}

.dist-unit {
  font-size: 26rpx;
  color: rgba(255,255,255,0.5);
  font-weight: 500;
  letter-spacing: 8rpx;
}
.radius-info { margin-top: 10rpx; }
.radius-text { font-size: 24rpx; color: rgba(255,255,255,0.42); }

/* Location details */
.location-details {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 16rpx;
  backdrop-filter: blur(10px);
}
.loc-detail-item { display: flex; align-items: center; gap: 12rpx; }
.loc-dot { width: 12rpx; height: 12rpx; border-radius: 50%; flex-shrink: 0; }
.user-dot   { background: #667EEA; box-shadow: 0 0 8rpx rgba(102,126,234,0.6); animation: dotPulse 2s ease-in-out infinite; }
.target-dot { background: #F5222D; box-shadow: 0 0 8rpx rgba(245,34,45,0.6); animation: dotPulse 2s ease-in-out infinite 1s; }
.loc-detail-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* ═══ Face Section ═══ */
.face-section { margin-bottom: 24rpx; }
.face-card {
  display: flex;
  align-items: center;
  justify-content: center;
}
.face-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 48rpx 0;
  position: relative;
  min-height: 420rpx;
  justify-content: center;
}
/* 模拟取景框：开发者工具没有真实相机时，仍然展示取景框以便演示/自测 */
.sim-guide {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 300rpx; height: 300rpx;
  border-radius: 50%;
  border: 3rpx dashed rgba(255,255,255,0.55);
  pointer-events: none;
  animation: simPulse 2.4s ease-in-out infinite;
}
.sim-guide-inner {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 300rpx; height: 300rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(102,126,234,0.16) 0%, rgba(102,126,234,0) 70%);
  pointer-events: none;
}
.sim-badge {
  position: absolute;
  bottom: 18rpx; left: 50%;
  transform: translateX(-50%);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(52,199,89,0.18);
  border: 1rpx solid rgba(52,199,89,0.4);
  font-size: 20rpx;
  color: #7BE495;
  white-space: nowrap;
}
@keyframes simPulse {
  0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.75; }
  50%      { transform: translate(-50%, -50%) scale(1.04); opacity: 1; }
}
.face-camera-icon {
  width: 96rpx; height: 96rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  display: flex; align-items: center; justify-content: center;
  border: 1rpx solid rgba(255,255,255,0.15);
}
.camera-emoji { font-size: 44rpx; }
.face-hint { font-size: 26rpx; color: rgba(255,255,255,0.6); }
.face-sub-hint { font-size: 22rpx; color: rgba(255,255,255,0.35); }

.face-preview-wrap {
  position: relative;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}
.face-preview {
  width: 320rpx; height: 320rpx;
  border-radius: 24rpx;
  border: 3rpx solid rgba(255,255,255,0.25);
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.15);
}
.face-retake {
  padding: 12rpx 32rpx;
  border-radius: 24rpx;
  background: rgba(255,255,255,0.15);
  backdrop-filter: blur(8px);
  color: #fff;
  font-size: 24rpx;
  transition: all 0.2s ease;
}
.face-retake:active { background: rgba(255,255,255,0.25); transform: scale(0.94); }

.face-camera-wrap {
  position: relative;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.face-camera {
  width: 100%;
  height: 560rpx;
  border-radius: 24rpx;
}
.face-guide-circle {
  position: absolute;
  top: 120rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 320rpx; height: 320rpx;
  border-radius: 50%;
  border: 3rpx dashed rgba(255,255,255,0.65);
  pointer-events: none;
}
.face-detect-status {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: rgba(255,255,255,0.6);
}
.face-detect-status.face-detected { color: #34C759; }
.face-shoot-btn {
  margin-top: 24rpx;
  width: 280rpx; height: 88rpx;
  border-radius: 44rpx;
  background: rgba(255,255,255,0.18);
  color: #fff;
  font-size: 30rpx;
  display: flex; align-items: center; justify-content: center;
  transition: all 0.2s ease;
}
.face-shoot-btn.shoot-ready {
  background: linear-gradient(135deg, #667EEA, #764BA2);
  box-shadow: 0 8rpx 24rpx rgba(102,126,234,0.4);
}
.face-shoot-btn:active { transform: scale(0.96); }

/* ═══ Combo Requirements ═══ */
.combo-requirements { display: flex; gap: 20rpx; margin-bottom: 24rpx; }
.combo-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 500;
  backdrop-filter: blur(10px);
  transition: all 0.3s ease;
}
.combo-met {
  background: rgba(52,199,89,0.15);
  color: #34C759;
  border: 1rpx solid rgba(52,199,89,0.25);
}
.combo-pending {
  background: rgba(255,255,255,0.06);
  color: rgba(255,255,255,0.4);
  border: 1rpx solid rgba(255,255,255,0.08);
}

/* ═══ Submit Button ═══ */
.submit-section { padding: 16rpx 0 32rpx; }
.submit-btn {
  width: 100%;
  height: 108rpx;
  border-radius: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1.2);
  position: relative;
  overflow: hidden;
}
.submit-btn::after {
  content: '';
  position: absolute;
  top: 0; left: -100%;
  width: 150%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.12), transparent);
  transform: skewX(-20deg);
  animation: shineSweep 3.5s ease-in-out infinite;
}
@keyframes shineSweep {
  0%, 100% { left: -100%; }
  50%      { left: 150%; }
}

.submit-active {
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  box-shadow: 0 8rpx 32rpx rgba(102,126,234,0.4);
}
.submit-active:active { transform: scale(0.96); }

.submit-disabled {
  background: rgba(255,255,255,0.08);
  border: 1rpx solid rgba(255,255,255,0.1);
  backdrop-filter: blur(10px);
}
.submit-loading {
  background: linear-gradient(135deg, #8B9CF7 0%, #9B7BC4 100%);
}

.submit-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 2rpx;
  position: relative;
  z-index: 1;
}
.submit-disabled .submit-text { color: rgba(255,255,255,0.3); }

.btn-loading-spinner {
  width: 36rpx; height: 36rpx;
  border: 3rpx solid rgba(255,255,255,0.25);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
  margin-right: 12rpx;
  position: relative;
  z-index: 1;
}

/* ═══ Success Modal ═══ */
.success-overlay {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0,0,0,0.45);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  animation: fadeIn 0.3s ease;
}
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

.success-modal {
  position: relative;
  width: 560rpx;
  background: rgba(255,255,255,0.92);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border-radius: 40rpx;
  padding: 60rpx 48rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: visible;
  box-shadow: 0 24rpx 80rpx rgba(0,0,0,0.2), 0 0 0 1rpx rgba(255,255,255,0.4);
}
.success-in {
  animation: successPop 0.6s cubic-bezier(0.68, -0.55, 0.27, 1.55) forwards;
}
@keyframes successPop {
  0%   { transform: scale(0.4); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

/* Confetti */
.confetti-container {
  position: absolute; inset: 0;
  overflow: visible;
  pointer-events: none;
}
.confetti {
  position: absolute;
  width: 12rpx; height: 12rpx;
  border-radius: 3rpx;
  top: -10rpx;
  animation: confettiFall 2.5s ease-out forwards;
  opacity: 0;
}
@keyframes confettiFall {
  0%   { transform: translateY(0) rotate(0deg) scale(1); opacity: 1; }
  100% { transform: translateY(520rpx) rotate(720deg) scale(0.2); opacity: 0; }
}

/* Check mark */
.success-check-wrap { position: relative; z-index: 1; margin-bottom: 24rpx; }
.success-check-circle {
  width: 120rpx; height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #34C759 0%, #30D158 100%);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(52,199,89,0.4);
  animation: checkScale 0.6s cubic-bezier(0.68, -0.55, 0.27, 1.55) 0.2s both;
}
@keyframes checkScale {
  0%   { transform: scale(0); }
  100% { transform: scale(1); }
}
.success-check-icon { font-size: 56rpx; color: #fff; font-weight: 700; }
.success-title { position: relative; z-index: 1; font-size: 40rpx; font-weight: 700; color: #1A1A2E; margin-bottom: 8rpx; }
.success-sub { position: relative; z-index: 1; font-size: 26rpx; color: #8888AA; margin-bottom: 16rpx; }
.success-distance {
  position: relative; z-index: 1;
  font-size: 24rpx; color: #667EEA;
  padding: 12rpx 24rpx;
  background: rgba(102,126,234,0.06);
  border-radius: 20rpx;
}

/* ═══ Animations ═══ */
.pulse-active .range-indicator {
  animation: greenPulse 0.6s ease;
}
@keyframes greenPulse {
  0%   { box-shadow: 0 0 0 0 rgba(82,196,26,0.5); }
  50%  { box-shadow: 0 0 0 24rpx rgba(82,196,26,0); }
  100% { box-shadow: 0 0 0 0 rgba(82,196,26,0); }
}
.shake-active { animation: shake 0.5s ease; }
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  10%, 50%, 90% { transform: translateX(-8rpx); }
  30%, 70%      { transform: translateX(8rpx); }
}
