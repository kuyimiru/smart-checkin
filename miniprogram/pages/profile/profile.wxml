<view class="container">
  <view style="background:linear-gradient(135deg,#667EEA,#764BA2);border-radius:24rpx;padding:32rpx;display:flex;flex-direction:column;align-items:center;margin-bottom:24rpx;">
    <view style="width:128rpx;height:128rpx;border-radius:50%;overflow:hidden;border:3rpx solid rgba(255,255,255,0.3);margin-bottom:14rpx;">
      <image wx:if="{{faceImagePreview}}" src="{{faceImagePreview}}" mode="aspectFill" style="width:100%;height:100%;" />
      <view wx:else style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,0.1);"><text style="font-size:48rpx;font-weight:800;color:#fff;">{{realName ? realName.charAt(0) : '?'}}</text></view>
    </view>
    <text style="font-size:36rpx;font-weight:800;color:#fff;margin-bottom:4rpx;">{{realName || '未设置姓名'}}</text>
    <text style="font-size:22rpx;color:rgba(255,255,255,0.5);margin-bottom:16rpx;">{{userInfo.idCard ? '已实名认证' : '未实名认证'}}</text>
    <view style="padding:10rpx 32rpx;border-radius:24rpx;background:rgba(255,255,255,0.15);border:1rpx solid rgba(255,255,255,0.2);" bindtap="goProfileEdit"><text style="font-size:24rpx;color:#fff;font-weight:500;">编辑资料</text></view>
  </view>

  <view style="display:flex;background:#fff;border-radius:20rpx;padding:28rpx 0;margin-bottom:24rpx;box-shadow:0 2rpx 8rpx rgba(0,0,0,0.03);">
    <view style="flex:1;display:flex;flex-direction:column;align-items:center;gap:4rpx;"><text style="font-size:34rpx;font-weight:800;color:#333;">{{stats.totalCheckIns || 0}}</text><text style="font-size:20rpx;color:#999;">累计打卡</text></view>
    <view style="width:1rpx;background:#f0f0f0;"></view>
    <view style="flex:1;display:flex;flex-direction:column;align-items:center;gap:4rpx;"><text style="font-size:34rpx;font-weight:800;color:#34C759;">{{stats.streak || 0}}</text><text style="font-size:20rpx;color:#999;">连续打卡</text></view>
    <view style="width:1rpx;background:#f0f0f0;"></view>
    <view style="flex:1;display:flex;flex-direction:column;align-items:center;gap:4rpx;"><text style="font-size:34rpx;font-weight:800;color:#667EEA;">{{stats.activityCount || 0}}</text><text style="font-size:20rpx;color:#999;">参与活动</text></view>
  </view>

  <view style="background:#fff;border-radius:20rpx;overflow:hidden;box-shadow:0 2rpx 8rpx rgba(0,0,0,0.03);margin-bottom:24rpx;">
    <view style="display:flex;justify-content:space-between;align-items:center;padding:24rpx;" bindtap="goProfileEdit"><view style="display:flex;align-items:center;gap:16rpx;"><text style="font-size:28rpx;">👤</text><text style="font-size:28rpx;color:#333;">个人信息</text></view><text style="font-size:30rpx;color:#ccc;">›</text></view>
    <view style="display:flex;justify-content:space-between;align-items:center;padding:24rpx;" bindtap="goMyActivities" data-tab="joined"><view style="display:flex;align-items:center;gap:16rpx;"><text style="font-size:28rpx;">🎯</text><text style="font-size:28rpx;color:#333;">我参与的活动</text></view><text style="font-size:30rpx;color:#ccc;">›</text></view>
    <view style="display:flex;justify-content:space-between;align-items:center;padding:24rpx;" bindtap="goMyActivities" data-tab="created"><view style="display:flex;align-items:center;gap:16rpx;"><text style="font-size:28rpx;">🚀</text><text style="font-size:28rpx;color:#333;">我发起的活动</text></view><text style="font-size:30rpx;color:#ccc;">›</text></view>
    <view style="display:flex;justify-content:space-between;align-items:center;padding:24rpx;" bindtap="goMyActivities" data-tab="managing"><view style="display:flex;align-items:center;gap:16rpx;"><text style="font-size:28rpx;">🛡️</text><text style="font-size:28rpx;color:#333;">我负责的活动</text></view><text style="font-size:30rpx;color:#ccc;">›</text></view>
    <view style="display:flex;justify-content:space-between;align-items:center;padding:24rpx;" bindtap="goCalendar"><view style="display:flex;align-items:center;gap:16rpx;"><text style="font-size:28rpx;">📅</text><text style="font-size:28rpx;color:#333;">我的日历</text></view><text style="font-size:30rpx;color:#ccc;">›</text></view>
    <view style="display:flex;justify-content:space-between;align-items:center;padding:24rpx;" bindtap="goPrivacy"><view style="display:flex;align-items:center;gap:16rpx;"><text style="font-size:28rpx;">🔒</text><text style="font-size:28rpx;color:#333;">隐私政策</text></view><text style="font-size:30rpx;color:#ccc;">›</text></view>
    <view style="display:flex;justify-content:space-between;align-items:center;padding:24rpx;" bindtap="goAbout"><view style="display:flex;align-items:center;gap:16rpx;"><text style="font-size:28rpx;">ℹ️</text><text style="font-size:28rpx;color:#333;">关于</text></view><text style="font-size:30rpx;color:#ccc;">›</text></view>
  </view>

  <view style="text-align:center;padding:20rpx 0;">
    <view style="display:inline-block;padding:14rpx 56rpx;border-radius:24rpx;border:1rpx solid rgba(255,59,48,0.15);" bindtap="logout"><text style="font-size:26rpx;color:#FF3B30;">退出登录</text></view>
  </view>
  <view class="safe-bottom"></view>
</view>
