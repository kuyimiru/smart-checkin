/* ═══════════════════════════════════════════════
   Activity Create — 创建活动
   表单 / 选项胶囊（.fi .fl .f-inp .ps .po .wc .wci .tc .tci .lp）
   统一由 app.wxss 提供，本页只做页面专属样式
   ═══════════════════════════════════════════════ */

page {
  background-color: #F5F7FA;
  background-image: linear-gradient(180deg, #E7ECFB 0%, #EFF3FB 280rpx, #F5F7FA 600rpx);
  background-repeat: no-repeat;
}

.container { padding: 32rpx 32rpx 0; }

/* 表单卡片给更充足的留白 */
.card { padding: 36rpx 32rpx; }

/* ═══ 负责人分组：浅色内嵌卡片，替代生硬分隔线 ═══ */
.mb {
  margin-bottom: 20rpx;
  padding: 24rpx;
  background: #F8F9FD;
  border-radius: 24rpx;
  box-shadow: inset 0 0 0 1rpx rgba(102, 126, 234, 0.06);
  animation: fadeInUp 320ms cubic-bezier(0.25, 0.8, 0.25, 1) backwards;
}
.mb:last-child { margin-bottom: 0; }
.mn-text { font-size: 26rpx; font-weight: 600; color: var(--text-2); }

/* 添加负责人：品牌色胶囊 */
.add-mgr {
  font-size: 26rpx;
  font-weight: 600;
  color: #667EEA;
  padding: 10rpx 24rpx;
  background: rgba(102, 126, 234, 0.08);
  border-radius: 999rpx;
  transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
}
.add-mgr:active { background: rgba(102, 126, 234, 0.16); transform: scale(0.96); }
