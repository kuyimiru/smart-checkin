/* ═══════════════════════════════════════════════
   Login — Aurora · Glass · Pure CSS Art
   ═══════════════════════════════════════════════ */

.login-wrapper {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

/* ═══ Multi-layer animated background ═══
   主渐变 #667EEA → #764BA2，background-size:400% 400% + 缓慢流动动画 */
.bg-layer {
  position: fixed;
  inset: 0;
  /* 降级底色：任何环境下都不会是白底 */
  background-color: #5B46C4;
  background-image: linear-gradient(135deg,
    #667EEA 0%,
    #764BA2 20%,
    #4F46E5 40%,
    #8E5BD1 60%,
    #5B3FB0 80%,
    #667EEA 100%);
  background-size: 400% 400%;
  z-index: -3;
  animation: auroraShift 18s ease-in-out infinite;
}

/* 柔光层：让流动渐变有体积感，不刺眼 */
.bg-layer::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 100% 70% at 20% 0%, rgba(255, 255, 255, 0.18) 0%, transparent 55%),
    radial-gradient(ellipse 90% 70% at 85% 25%, rgba(168, 85, 247, 0.30) 0%, transparent 50%),
    radial-gradient(ellipse 100% 80% at 50% 100%, rgba(15, 11, 46, 0.42) 0%, transparent 60%);
}

@keyframes auroraShift {
  0%   { background-position: 0% 50%; }
  50%  { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

/* Subtle noise texture via pseudo-element */
.bg-layer::after {
  content: '';
  position: absolute;
  inset: 0;
  background:
    repeating-linear-gradient(0deg, transparent, transparent 2rpx, rgba(255,255,255,0.008) 2rpx, rgba(255,255,255,0.008) 4rpx),
    repeating-linear-gradient(90deg, transparent, transparent 2rpx, rgba(255,255,255,0.006) 2rpx, rgba(255,255,255,0.006) 4rpx);
}

/* ═══ Floating glass orbs — pure CSS ═══ */
.bg-orb {
  position: fixed;
  border-radius: 50%;
  z-index: -2;
  pointer-events: none;
}
.orb-1 {
  width: 420rpx; height: 420rpx;
  background: radial-gradient(circle, rgba(168,85,247,0.25) 0%, transparent 70%);
  top: -120rpx; right: -100rpx;
  filter: blur(60px);
  animation: orbDrift1 12s ease-in-out infinite;
}
.orb-2 {
  width: 320rpx; height: 320rpx;
  background: radial-gradient(circle, rgba(59,130,246,0.2) 0%, transparent 70%);
  bottom: 10%; left: -120rpx;
  filter: blur(70px);
  animation: orbDrift2 14s ease-in-out infinite;
}
.orb-3 {
  width: 240rpx; height: 240rpx;
  background: radial-gradient(circle, rgba(236,72,153,0.22) 0%, transparent 70%);
  top: 30%; right: 10%;
  filter: blur(55px);
  animation: orbDrift3 9s ease-in-out infinite;
}
.orb-4 {
  width: 180rpx; height: 180rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.12) 0%, transparent 65%);
  bottom: 25%; right: 20%;
  filter: blur(40px);
  animation: orbDrift1 10s ease-in-out infinite reverse;
}

@keyframes orbDrift1 {
  0%, 100% { transform: translate(0, 0) scale(1); }
  25%  { transform: translate(30rpx, -40rpx) scale(1.08); }
  50%  { transform: translate(-20rpx, 20rpx) scale(0.94); }
  75%  { transform: translate(15rpx, -10rpx) scale(1.04); }
}
@keyframes orbDrift2 {
  0%, 100% { transform: translate(0, 0) scale(1); }
  50%  { transform: translate(-40rpx, -50rpx) scale(1.12); }
}
@keyframes orbDrift3 {
  0%, 100% { transform: translate(0, 0) rotate(0deg); }
  50%  { transform: translate(30rpx, 25rpx) rotate(10deg); }
}

/* ═══ Content ═══ */
.login-content {
  position: relative;
  z-index: 1;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 48rpx;
  box-sizing: border-box;
}

/* ═══ Brand Area ═══ */
.brand-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
  animation: fadeInUp 560ms cubic-bezier(0.25, 0.8, 0.25, 1) backwards;
}

/* Logo with pulsing CSS rings */
.logo-pulse-ring {
  position: absolute;
  width: 200rpx; height: 200rpx;
}
.logo-pulse {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 2rpx solid rgba(255,255,255,0.15);
  animation: pulseRing 3s ease-out infinite;
}
.logo-pulse-1 {
  animation-delay: 0s;
}
.logo-pulse-2 {
  animation-delay: 1s;
}
@keyframes pulseRing {
  0%   { transform: scale(0.7); opacity: 0.5; border-width: 3rpx; }
  100% { transform: scale(1.8); opacity: 0; border-width: 1rpx; }
}

/* Logo ring with glass */
.logo-ring {
  position: relative;
  width: 180rpx; height: 180rpx;
  margin-bottom: 24rpx;
}

.logo-inner {
  position: absolute;
  inset: 10rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.1);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1.5rpx solid rgba(255,255,255,0.2);
  z-index: 1;
  box-shadow:
    0 8rpx 32rpx rgba(0,0,0,0.1),
    inset 0 1rpx 0 rgba(255,255,255,0.15);
}

.logo-icon {
  width: 100rpx; height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(255,255,255,0.25), rgba(255,255,255,0.08));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
}

.logo-char {
  font-size: 48rpx;
  color: #FFFFFF;
  font-weight: 800;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
}

/* Rotating halo — pure CSS border trick */
.logo-halo {
  position: absolute;
  inset: -6rpx;
  border-radius: 50%;
  border: 2rpx solid transparent;
  border-top-color: rgba(255,255,255,0.35);
  border-right-color: rgba(255,255,255,0.18);
  border-bottom-color: rgba(255,255,255,0.06);
  animation: haloRotate 5s linear infinite;
}
.logo-halo::after {
  content: '';
  position: absolute;
  top: -4rpx; right: -4rpx;
  width: 10rpx; height: 10rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.6);
  box-shadow: 0 0 12rpx rgba(255,255,255,0.4);
}

@keyframes haloRotate {
  to { transform: rotate(360deg); }
}

.brand-name {
  font-size: 52rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 16rpx;
  margin-bottom: 10rpx;
  text-shadow: 0 4rpx 20rpx rgba(0,0,0,0.12);
}

.brand-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
  letter-spacing: 3rpx;
  font-weight: 400;
}

/* ═══ Login Glass Card ═══ */
.login-glass-card {
  position: relative;
  width: 100%;
  /* 降级底色 + 玻璃层（半透明 + backdrop-filter blur） */
  background-color: rgba(58, 42, 128, 0.34);
  background-image: linear-gradient(140deg, rgba(255, 255, 255, 0.20) 0%, rgba(255, 255, 255, 0.06) 60%);
  backdrop-filter: blur(30px) saturate(160%);
  -webkit-backdrop-filter: blur(30px) saturate(160%);
  border-radius: 40rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  padding: 40rpx;
  margin-bottom: 32rpx;
  box-shadow:
    0 24rpx 60rpx rgba(15, 10, 40, 0.28),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.22);
  animation: fadeInUp 620ms cubic-bezier(0.25, 0.8, 0.25, 1) 120ms backwards;
}

.welcome-row {
  text-align: center;
  margin-bottom: 32rpx;
}

.welcome-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.9);
  margin-bottom: 8rpx;
}

.welcome-sub {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.4);
}

/* ═══ WeChat Login Button ═══ */
.wechat-login-btn {
  position: relative;
  width: 100%;
  height: 108rpx;
  border-radius: 56rpx;
  background: rgba(255,255,255,0.92);
  backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-shadow:
    0 12rpx 40rpx rgba(0,0,0,0.15),
    0 0 0 1rpx rgba(255,255,255,0.3);
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1.2);
}
.wechat-login-btn:active {
  transform: scale(0.96);
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.1);
}
.wechat-login-btn.btn-loading {
  background: rgba(255,255,255,0.7);
}

/* Shine sweep */
.btn-shine {
  position: absolute;
  inset: 0;
  background: linear-gradient(105deg,
    transparent 35%,
    rgba(255,255,255,0.2) 47%,
    rgba(255,255,255,0.4) 50%,
    rgba(255,255,255,0.2) 53%,
    transparent 65%);
  transform: translateX(-100%);
  animation: shineSweep 4.5s ease-in-out infinite;
}
@keyframes shineSweep {
  0%, 100% { transform: translateX(-100%); }
  50%      { transform: translateX(100%); }
}

.btn-inner {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.wx-icon-wrap {
  width: 52rpx; height: 52rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #07C160 0%, #06AD56 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(7,193,96,0.35);
}
.wx-icon-em {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 700;
}

.btn-label {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A2E;
  letter-spacing: 1rpx;
}
.btn-loading .btn-label { color: #999; }

/* Loading spinner — pure CSS */
.btn-spinner {
  width: 36rpx; height: 36rpx;
  border: 3rpx solid rgba(102,126,234,0.15);
  border-top-color: #667EEA;
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* ═══ Agreement ═══ */
.agreement-row {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 2rpx;
  margin-top: 24rpx;
}
.agreement-dot {
  width: 28rpx; height: 28rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255,255,255,0.3);
  margin-right: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}
.agreement-dot.dot-checked {
  background: linear-gradient(135deg, #07C160, #06AD56);
  border-color: #07C160;
}
.dot-check-icon {
  font-size: 16rpx;
  color: #FFFFFF;
  font-weight: 700;
}
.agreement-text { font-size: 22rpx; color: rgba(255,255,255,0.35); }
.agreement-link {
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
  font-weight: 500;
}

/* Version */
.version-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.18);
  letter-spacing: 2rpx;
}

/* ═══ Privacy Dialog ═══ */
.dialog-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 48rpx;
  animation: fadeIn 0.25s ease;
}
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
/* 本页专属：入场（与 app.wxss 中同名关键帧保持一致，保证页面级可用） */
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(28rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

.dialog-card {
  width: 100%;
  max-width: 600rpx;
  background: rgba(255,255,255,0.95);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 36rpx;
  padding: 40rpx 32rpx 28rpx;
  display: flex;
  flex-direction: column;
  max-height: 80vh;
  box-shadow: 0 24rpx 80rpx rgba(0,0,0,0.25), 0 0 0 1rpx rgba(255,255,255,0.4);
  animation: scaleUp 0.35s cubic-bezier(0.25, 0.8, 0.25, 1.2);
}
@keyframes scaleUp {
  from { transform: scale(0.85); opacity: 0; }
  to   { transform: scale(1); opacity: 1; }
}

.dialog-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A2E;
  text-align: center;
  margin-bottom: 24rpx;
}
.dialog-body { flex: 1; max-height: 480rpx; margin-bottom: 24rpx; }
.dialog-text {
  font-size: 24rpx;
  color: #4A4A6A;
  line-height: 1.9;
  white-space: pre-wrap;
}
.dialog-actions { display: flex; gap: 20rpx; }
.dialog-btn {
  flex: 1;
  height: 92rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.25s ease;
}
.dialog-btn:active { transform: scale(0.95); }
.dialog-btn-cancel { background: #F5F6FA; color: #8888AA; }
.dialog-btn-confirm {
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(102,126,234,0.3);
}
