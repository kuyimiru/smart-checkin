<view class="container">
  <nav-back />
  <view class="card" style="display:flex;flex-direction:column;align-items:center;padding:36rpx 28rpx;border:2rpx dashed #ddd;" bindtap="chooseFile">
    <view style="width:88rpx;height:88rpx;border-radius:22rpx;background:rgba(102,126,234,0.06);display:flex;align-items:center;justify-content:center;margin-bottom:14rpx;"><text style="font-size:40rpx;">📂</text></view>
    <text style="font-size:28rpx;font-weight:600;color:#333;margin-bottom:4rpx;">点击上传花名册</text>
    <text style="font-size:22rpx;color:#999;">支持 .xlsx / .xls / .csv 格式</text>
  </view>
  <view class="card">
    <view class="row-between" style="margin-bottom:12rpx;"><text style="font-size:20rpx;color:#999;font-weight:600;letter-spacing:2rpx;">花名册列表</text><text style="font-size:22rpx;color:#999;">共 {{rosterList.length}} 人</text></view>
    <view wx:if="{{rosterList.length === 0}}" style="text-align:center;padding:28rpx 0;color:#ccc;">暂无数据</view>
    <view wx:for="{{rosterList}}" wx:key="id" style="display:flex;align-items:center;gap:12rpx;padding:12rpx 0;border-bottom:1rpx solid #f5f5f5;">
      <view style="width:56rpx;height:56rpx;border-radius:50%;background:rgba(102,126,234,0.08);display:flex;align-items:center;justify-content:center;"><text style="font-size:22rpx;font-weight:700;color:#667EEA;">{{item.name ? item.name.charAt(0) : '?'}}</text></view>
      <view style="flex:1;"><view style="display:flex;align-items:center;gap:6rpx;"><text style="font-size:26rpx;font-weight:600;color:#333;">{{item.name}}</text><text style="font-size:20rpx;color:#999;">{{item.gender}}</text></view><text wx:if="{{item.phone}}" style="font-size:20rpx;color:#999;">{{item.phone}}</text></view>
      <view style="padding:4rpx 12rpx;border-radius:12rpx;font-size:20rpx;font-weight:600;{{item.matchedUserId ? 'background:rgba(52,199,89,0.08);color:#34C759;' : 'background:rgba(255,149,0,0.06);color:#FF9500;'}}">{{item.matchedUserId ? '已匹配' : '未匹配'}}</view>
    </view>
  </view>
  <view class="safe-bottom"></view>
</view>
