<view class="container">
  <!-- 自绘导航栏页面：返回键自动避开状态栏；下面留出等高的占位，避免压住统计条 -->
  <nav-back custom-nav="{{true}}" />
  <view style="height: 180rpx;"></view>
  <view style="display:flex;gap:10rpx;padding-bottom:18rpx;">
    <view style="display:flex;align-items:center;gap:4rpx;padding:8rpx 18rpx;border-radius:18rpx;background:#fff;box-shadow:0 2rpx 8rpx rgba(0,0,0,0.03);"><text style="font-size:24rpx;font-weight:700;color:#333;">{{totalCount}}</text><text style="font-size:20rpx;color:#999;">总计</text></view>
    <view style="display:flex;align-items:center;gap:4rpx;padding:8rpx 18rpx;border-radius:18rpx;background:#fff;box-shadow:0 2rpx 8rpx rgba(0,0,0,0.03);"><text style="font-size:24rpx;font-weight:700;color:#34C759;">{{normalCount}}</text><text style="font-size:20rpx;color:#999;">正常</text></view>
    <view style="display:flex;align-items:center;gap:4rpx;padding:8rpx 18rpx;border-radius:18rpx;background:#fff;box-shadow:0 2rpx 8rpx rgba(0,0,0,0.03);"><text style="font-size:24rpx;font-weight:700;color:#FF9500;">{{lateCount}}</text><text style="font-size:20rpx;color:#999;">迟到</text></view>
    <view style="display:flex;align-items:center;gap:4rpx;padding:8rpx 18rpx;border-radius:18rpx;background:#fff;box-shadow:0 2rpx 8rpx rgba(0,0,0,0.03);"><text style="font-size:24rpx;font-weight:700;color:#FF3B30;">{{abnormalCount}}</text><text style="font-size:20rpx;color:#999;">异常</text></view>
  </view>
  <view wx:if="{{loading}}" style="display:flex;flex-direction:column;align-items:center;padding:80rpx 0;gap:14rpx;">
    <view style="width:44rpx;height:44rpx;border:3rpx solid #eee;border-top-color:#667EEA;border-radius:50%;animation:spin 0.8s linear infinite;"></view><text style="font-size:24rpx;color:#999;">加载中...</text>
  </view>
  <view wx:elif="{{records.length === 0}}" class="empty-state"><text class="empty-emoji">📭</text><text class="empty-title">暂无打卡记录</text></view>
  <view wx:for="{{records}}" wx:key="id" class="card" style="padding:18rpx 22rpx;margin-bottom:12rpx;" data-id="{{item.id}}" bindtap="toggleExpand">
    <view style="display:flex;justify-content:space-between;align-items:center;">
      <view style="display:flex;align-items:center;gap:10rpx;">
        <view style="width:12rpx;height:12rpx;border-radius:50%;background:{{item.status === 'normal' ? '#34C759' : item.status === 'late' ? '#FF9500' : '#FF3B30'}};"></view>
        <view><text style="font-size:26rpx;font-weight:600;color:#333;display:block;">{{item.checkInDate}}</text><text style="font-size:20rpx;color:#999;">{{item.checkInTime}}</text></view>
      </view>
      <view style="display:flex;align-items:center;gap:10rpx;">
        <text class="tag {{item.status === 'normal' ? 'tag-ok' : item.status === 'late' ? 'tag-late' : 'tag-bad'}}">{{item.status === 'normal' ? '正常' : item.status === 'late' ? '迟到' : '异常'}}</text>
        <text style="font-size:26rpx;color:#ccc;transform:{{expandedId === item.id ? 'rotate(90deg)' : 'rotate(0deg)'}};transition:0.3s;">›</text>
      </view>
    </view>
    <view wx:if="{{expandedId === item.id}}">
      <view style="height:1rpx;background:#f0f0f0;margin:14rpx 0;"></view>
      <view style="display:flex;flex-wrap:wrap;gap:10rpx;">
        <view style="width:calc(50% - 5rpx);"><text style="font-size:20rpx;color:#bbb;display:block;">打卡日期</text><text style="font-size:24rpx;color:#555;">{{item.checkInDate}}</text></view>
        <view style="width:calc(50% - 5rpx);"><text style="font-size:20rpx;color:#bbb;display:block;">打卡时间</text><text style="font-size:24rpx;color:#555;">{{item.checkInTime}}</text></view>
        <view style="width:calc(50% - 5rpx);"><text style="font-size:20rpx;color:#bbb;display:block;">打卡状态</text><text style="font-size:24rpx;color:{{item.status === 'normal' ? '#34C759' : item.status === 'late' ? '#FF9500' : '#FF3B30'}};">{{item.status === 'normal' ? '✓ 正常' : item.status === 'late' ? '⚠ 迟到' : '✗ 异常'}}</text></view>
        <view style="width:calc(50% - 5rpx);"><text style="font-size:20rpx;color:#bbb;display:block;">打卡方式</text><text style="font-size:24rpx;color:#555;">{{item.type === 'location' ? '📍 定位' : item.type === 'face' ? '📷 人脸' : '📍📷 组合'}}</text></view>
      </view>
    </view>
  </view>
  <view class="safe-bottom"></view>
</view>
