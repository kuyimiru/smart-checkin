/* ═══════════════════════════════════════════════
   Activity Edit — 编辑活动
   表单体系统一由 app.wxss 提供，本页只做页面专属样式
   ═══════════════════════════════════════════════ */

page {
  background-color: #F5F7FA;
  background-image: linear-gradient(180deg, #E7ECFB 0%, #EFF3FB 280rpx, #F5F7FA 600rpx);
  background-repeat: no-repeat;
}

.container { padding: 32rpx 32rpx 0; }
.card { padding: 36rpx 32rpx; }

/* ═══ 打卡方式（只读）：未选中项弱化，选中项高亮且不可按压 ═══ */
.tci {
  opacity: 0.45;
  transition: opacity 300ms cubic-bezier(0.4, 0, 0.2, 1),
              box-shadow 300ms cubic-bezier(0.4, 0, 0.2, 1);
}
.tci-on { opacity: 1; }
.tci:active { transform: none; }
