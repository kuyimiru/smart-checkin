/* 常驻返回键：固定在左上角，浮在页面内容之上，不参与布局 */
.nav-back {
  position: fixed;
  left: 20rpx;
  z-index: 9999;
  display: flex;
  align-items: center;
  height: 64rpx;
  padding: 0 26rpx 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(102, 126, 234, 0.18);
  box-shadow: 0 8rpx 22rpx rgba(31, 41, 55, 0.14);
  transition: transform 160ms cubic-bezier(0.34, 1.56, 0.64, 1), opacity 160ms ease;
}

/* 纯 CSS 画的左箭头，避免依赖图片资源 */
.nav-back__arrow {
  width: 16rpx;
  height: 16rpx;
  margin-right: 10rpx;
  margin-left: 4rpx;
  border-left: 4rpx solid #667EEA;
  border-bottom: 4rpx solid #667EEA;
  transform: rotate(45deg);
}

.nav-back__text {
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1;
  color: #4B5563;
}

.nav-back--hover {
  opacity: 0.72;
  transform: scale(0.93);
}
